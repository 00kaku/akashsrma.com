{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.2",
	"port": 8890,
	"testsEnvironment": true,
	"plugins": [
		"./plugins/akashsrma-features"
	],
	"themes": [
		"./themes/akashsrma-magazine"
	],
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"SCRIPT_DEBUG": true,
		"WP_DEVELOPMENT_MODE": "theme"
	},
	"env": {
		"tests": {
			"mappings": {
				"wp-content/akashsrma-repo": "."
			}
		}
	}
}
