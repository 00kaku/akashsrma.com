# Dependencies (`npm install`, `composer install`)
/node_modules/
/vendor/

# The packages' build/ and vendor/ (autoloaders) ARE committed: the server can't build, so it
# deploys what git holds. CI fails if they differ from a fresh `npm run build`.
/dist/
*.zip

# Local environment and secrets
.wp-env.override.json
.env
.env.*
!.env.example

# Tool caches and reports
.eslintcache
.stylelintcache
.phpcs-cache
.phpcs.cache
.phpunit.result.cache
.phpunit.cache/
coverage/
/artifacts/

# Local-only working files: scripts and notes kept for our own understanding, not published
/bin/
/docs/

# Logs
*.log

# Editors and operating systems
.idea/
.vscode/
*.swp
*~
.DS_Store
Thumbs.db
